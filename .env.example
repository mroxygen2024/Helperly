# ==============================================================================
# SERVANT MARKETPLACE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# --- APPLICATION ---
APP_NAME="Servant Marketplace"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=base64:random_generated_key_for_encryption

# --- DATABASE (MongoDB Atlas) ---
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?appName=Servant"
MONGODB_DB=servant_marketplace

# --- CACHE & SESSION (Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
SESSION_NAME=servant_session


# --- SECURITY ---
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_TTL_SECONDS=3600

# --- THIRD-PARTY SERVICES (ImageKit) ---
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# --- MAIL (SMTP) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=null
SMTP_PASSWORD=null
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=no-reply@servant-marketplace.local
SMTP_FROM_NAME="Servant Marketplace"

# --- FILE STORAGE ---
UPLOAD_PATH=public/uploads
MAX_UPLOAD_SIZE=64M
